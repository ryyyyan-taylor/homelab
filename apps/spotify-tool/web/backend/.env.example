# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=https://spotify.lab.ryantaylor.tech/api/auth/callback

# Server Configuration
PORT=3010
HOST=0.0.0.0
NODE_ENV=production
SESSION_SECRET=your_session_secret_here

# Frontend URL (used for CORS; same origin in the single-container deploy)
FRONTEND_URL=https://spotify.lab.ryantaylor.tech

# Database
DB_PATH=/app/data/spotify-client.db

# Downloader service (spotdl/ffmpeg), reached over cluster-internal DNS
DOWNLOADER_URL=http://downloader:8000
