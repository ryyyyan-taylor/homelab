---
# Copy this to proxmox.yml and fill in token_secret.
# proxmox.yml is gitignored — never commit the token.
plugin: community.proxmox.proxmox
url: https://10.0.1.135:8006
user: root@pam
token_id: terraform
token_secret: "REPLACE_ME"
validate_certs: false
want_facts: true

compose:
  # Derives ansible_host from CT ID — works for stopped containers too.
  # All LXCs follow the 10.0.1.<vmid> convention.
  ansible_host: "'10.0.1.' + (proxmox_vmid | string)"

# Only include the LXC containers — exclude Talos VMs (200-202) and Proxmox host node
filters:
  - proxmox_vmid | int in [151, 152, 153, 154, 160, 161, 170]

groups:
  game_servers:   proxmox_vmid | int in [151, 152, 153, 154]
  infrastructure: proxmox_vmid | int in [160, 161]
  ai:             proxmox_vmid | int in [170]
